{
  "name": "fanzup",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fanzup/web --filter @fanzup/api dev",
    "dev:web": "pnpm --filter @fanzup/web dev",
    "dev:api": "pnpm --filter @fanzup/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:copy": "pnpm --filter @fanzup/web lint:copy",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.types.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.20.5",
    "otplib": "^12.0.1",
    "supabase": "^2.119.0"
  }
}
