# apps/web/.env.local — public values only (these ship to the browser).
# Leave unset: the app calls same-origin /api (Vercel routes it to the api service; Vite proxies it locally).
# VITE_API_URL=
VITE_SUPABASE_URL=http://127.0.0.1:55321
# Supabase "publishable" (anon) key — safe in the browser; RLS protects the data.
VITE_SUPABASE_ANON_KEY=
# Feature flags
VITE_FLAG_LAYER2=false
VITE_FLAG_POSTBETA=false
