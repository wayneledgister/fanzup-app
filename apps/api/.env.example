# apps/api/.env — copy to .env for local dev. Never commit real values.

# Postgres connection. Local Supabase (after `pnpm db:start`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Hosted Supabase → Connect:
#   on Vercel (serverless)      → "Transaction pooler", port 6543 (prepared statements auto-disabled)
#   on a long-running host      → "Session pooler", port 5432
DB_POOL_MAX=5

# Supabase project URL — used to verify user JWTs via the project's JWKS.
SUPABASE_URL=http://127.0.0.1:55321
# Optional: only if your project still uses the legacy HS256 JWT secret.
# SUPABASE_JWT_SECRET=

# Stripe TEST keys only (FR-PAY-008): live keys are refused at startup. Stripe is not escrow — see SETUP.md.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# "sandbox" = no network; local/CI only (refused in deployed environments). "stripe-test" = Stripe test mode.
ESCROW_PROVIDER=sandbox
# local | ci | staging | production. Deployed environments fail closed.
DEPLOY_ENV=local
# Web origin for return links (Stripe onboarding).
PUBLIC_WEB_URL=http://localhost:5173
# Worker loop interval.
WORKER_INTERVAL_MS=30000

PORT=8787

# Vercel Cron → GET /api/internal/tick sends `Authorization: Bearer $CRON_SECRET`. 16+ random chars.
# CRON_SECRET=
CORS_ORIGINS=http://localhost:5173
