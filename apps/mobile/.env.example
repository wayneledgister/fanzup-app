# Copy to .env.local for `pnpm --filter @fanzup/mobile start` (docs/MOBILE.md). Public values only.
# On a phone, "localhost" is the phone: use your computer's LAN IP, or `expo start --tunnel` plus a public API URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787/api
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
